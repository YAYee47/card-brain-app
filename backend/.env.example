# 後端環境變數設定範本
# 複製此檔案為 .env 並填入真實數值

# Gemini API Key (必填：用於 OCR 視覺辨識與爬蟲文字解析)
# 申請網址：https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 資料庫連線字串 (預設使用本地 SQLite，生產環境可改為 PostgreSQL)
# SQLite (開發): sqlite+aiosqlite:///./card_brain.db
# PostgreSQL (生產): postgresql+asyncpg://user:password@localhost/card_brain
DATABASE_URL=sqlite+aiosqlite:///./card_brain.db
